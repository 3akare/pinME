{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinme",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "observability": { "enabled": true },
  // Web Push (wake-up only). The private half is the VAPID_PRIVATE_KEY secret.
  "vars": {
    "VAPID_PUBLIC_KEY": "BKEQ_bKUPFHQmYLCrxxFF8pOMU3uHpjCSnVGMFBbYGS9lmbMG_E1pzLRbQqt8Uq1Xbd7irpF4ctrX10tzaPXvSI",
    "VAPID_SUBJECT": "https://pinme.bakaredavid007.workers.dev"
  },
  "durable_objects": {
    "bindings": [
      { "name": "PIN_MAILBOX", "class_name": "PinMailbox" },
      { "name": "ECHO_DO", "class_name": "EchoDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PinMailbox", "EchoDO"] }
  ]
}
